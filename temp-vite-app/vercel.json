{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "desarrollo-*": false,
      "agent/*": false
    }
  },
  "rewrites": [
    { "source": "/estado", "destination": "/index.html" },
    { "source": "/consultar", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/confirmar", "destination": "/index.html" },
    { "source": "/validar-pago", "destination": "/index.html" },
    { "source": "/preparando", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
